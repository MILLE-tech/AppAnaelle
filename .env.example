# ============================================================================
# Supabase — Project Settings > API
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxx...

# Clé "service_role" — SERVEUR UNIQUEMENT, ne jamais exposer au client.
# Utilisée pour supprimer les fichiers du Storage après extraction du texte.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxx...

# ============================================================================
# Groq — https://console.groq.com/keys (gratuit, sans CB)
# ============================================================================
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx

# Modèle texte (fiches, questions, correction). Ajuste ce nom si Groq fait
# évoluer son offre gratuite (voir la liste à jour et les quotas sur
# https://console.groq.com/docs/rate-limits).
GROQ_TEXT_MODEL=openai/gpt-oss-120b

# Modèle vision (extraction des photos de cours et PDF scannés). Doit
# supporter les entrées image ; laisser tel quel sauf changement d'offre.
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# ============================================================================
# Application
# ============================================================================
# URL publique du site (utilisée pour les liens de confirmation d'email).
# En local : http://localhost:3000 — en prod : https://ton-projet.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
