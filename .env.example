# ============================================================================
# Supabase — Project Settings > API
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxx...

# Clé "service_role" — SERVEUR UNIQUEMENT, ne jamais exposer au client.
# Utilisée pour supprimer les fichiers du Storage après extraction du texte.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxx...

# ============================================================================
# Google AI Studio — https://aistudio.google.com/app/apikey (gratuit, sans CB)
# ============================================================================
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxx

# Modèle du palier gratuit. Ajuste ce nom si Google change l'offre gratuite
# (voir la liste à jour sur https://ai.google.dev/gemini-api/docs/models).
GEMINI_MODEL=gemini-2.5-flash

# ============================================================================
# Application
# ============================================================================
# URL publique du site (utilisée pour les liens de confirmation d'email).
# En local : http://localhost:3000 — en prod : https://ton-projet.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
